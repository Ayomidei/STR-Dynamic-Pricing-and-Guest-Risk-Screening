        "jsCode": "// Firecrawl Response Parser & Table 4 Payload Formatter\nconst item = $input.item.json;\nconst propertyRecordId = [$('Fetch Properties Target URLs').item.json.id]\n\n// Extract structured schema values from Firecrawl's extract output\nconst extractData = item.data?.extract || item.extract || {};\nconst observedRate = Number(extractData.observed_nightly_rate) || 0;\nconst competitorName = extractData.competitor_name || \"Scraped Competitor Listing\";\n\n// Determine ingestion health status for Table 4\nconst scrapeStatus = (observedRate > 0) ? \"ACTIVE\" : \"FAILED\";\n\nreturn {\n  json: {\n    property_airtable_id: propertyRecordId,\n    competitor_name: competitorName,\n    observed_nightly_rate: observedRate,\n    last_scraped_at: new Date().toISOString(),\n    status: scrapeStatus\n  }\n};"
