    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// =========================================================================\n// WF-1: RECONCILED ADDITIVE DYNAMIC PRICING ENGINE\n// =========================================================================\n\nconst item = $input.item.json;\nconst fields = $json || {};\n\n// 1. Core Property Base Rates & Limits$json['Base Nightly Price']\nconst basePrice = Number(fields['Base Nightly Price']) || 100000;\nconst minPrice = Number(fields[\"Min Price\"]) || 70000;\nconst maxPrice = Number(fields[\"Max Price\"]) || 150000;\n\n// 2. Extract Linked Competitor Market Rates (Table 4)\nconst competitorRates = fields['Observed nightly rate'] || []; \nlet deltaCompetitor = 0.00;\n\nif (competitorRates.length > 0) {\n  const compAvg = competitorRates.reduce((sum, rate) => sum + Number(rate), 0) / competitorRates.length;\n  if (compAvg > basePrice) {\n    deltaCompetitor = 0.10; // +10% boost if competitor avg higher than base\n  }\n}\n\n// 3. Extract Local Event Impact Signals (Table 5)\nconst eventImpactLevel = (fields[\"Impact Level\"] || \"NONE\");\nlet mEvent = 0.00;\n\nif (eventImpactLevel === \"HIGH\") {\n  mEvent = 0.25;\n} else if (eventImpactLevel === \"MEDIUM\") {\n  mEvent = 0.10;\n}\n\n// 4. Weekend Multiplier Check (Fri/Sat)\nconst today = new Date();\nconst dayOfWeek = today.getDay(); // 0 = Sun, 5 = Fri, 6 = Sat\nconst isWeekend = (dayOfWeek === 5 || dayOfWeek === 6);\nconst mWeekend = isWeekend ? 0.15 : 0.00;\n\n// 5. Reconciled Additive Factor Calculation\n// Recommended Price = Base Price * (1 + Δ Competitor + M Event + M Weekend)\nconst rawMultiplier = 1 + deltaCompetitor + mEvent + mWeekend;\nconst calculatedPrice = Math.round(basePrice * rawMultiplier);\n\n// 6. Calculate Consolidated Demand Level Label\nlet demandLevel = \"LOW\";\nconst totalDemandFactor = mEvent + mWeekend;\n\nif (totalDemandFactor >= 0.25) {\n  demandLevel = \"HIGH\";\n} else if (totalDemandFactor > 0) {\n  demandLevel = \"MEDIUM\";\n}\n\n// 7. Enforce Safety Floor & Ceiling Boundaries\nconst finalRecommendedPrice = Math.min(Math.max(calculatedPrice, minPrice), maxPrice);\n\n// 8. Structure Output Object\nreturn {\n  json: {\n    property_record_id: item.id,\n    property_id: fields[\"Property ID\"],\n    base_price: basePrice,\n    min_price: minPrice,\n    max_price: maxPrice,\n    calculated_price: calculatedPrice,\n    final_recommended_price: finalRecommendedPrice,\n    demand_level: demandLevel,\n    is_weekend: isWeekend ? \"YES\" : \"NO\",\n    event_impact: eventImpactLevel,\n    delta_competitor: deltaCompetitor,\n    evaluated_at: new Date().toISOString()\n  }\n};"
      },
