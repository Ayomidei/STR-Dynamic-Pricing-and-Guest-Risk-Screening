# ==============================================================================
# ENVIRONMENT CONFIGURATION BLUEPRINT
# Copy this file to '.env' and populate with your actual secret credentials.
# DO NOT COMMIT YOUR ACTUAL '.env' FILE TO GITHUB.
# ==============================================================================

# --- AIRTABLE CONFIGURATION ---
AIRTABLE_API_KEY=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# --- FIRECRAWL CONFIGURATION ---
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- N8N WORKFLOW ENDPOINTS ---
N8N_BASE_URL=https://your-n8n-instance.com
N8N_WEBHOOK_BOOKING_INGEST=https://your-n8n-instance.com/webhook/booking-request
N8N_WEBHOOK_TELEGRAM_CALLBACK=https://your-n8n-instance.com/webhook/telegram-callback
N8N_WEBHOOK_MANUAL_OVERRIDE=https://your-n8n-instance.com/webhook/manual-override

# --- GEMINI AI CONFIGURATION ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- TELEGRAM BOT CONFIGURATION ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_CHAT_ID=your_telegram_chat_id_here

